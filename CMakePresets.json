{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "macos",
            "displayName": "macOS (Homebrew)",
            "inherits": "default",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos-release",
            "displayName": "macOS Release",
            "inherits": "macos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows",
            "displayName": "Windows (vcpkg)",
            "inherits": "default",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
            "toolchainFile": "$env{VCPKG_INSTALLATION_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "CMAKE_BUILD_TYPE": "Release",
                "FETCHCONTENT_FULLY_DISCONNECTED": "OFF"
            }
        },
        {
            "name": "linux",
            "displayName": "Linux",
            "inherits": "default",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ci-windows",
            "displayName": "CI Windows",
            "inherits": "windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ci-macos",
            "displayName": "CI macOS",
            "inherits": "macos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "macos",
            "configurePreset": "macos"
        },
        {
            "name": "windows",
            "configurePreset": "windows",
            "configuration": "Release"
        },
        {
            "name": "ci-windows",
            "configurePreset": "ci-windows",
            "configuration": "Release",
            "targets": ["pixel-roguelike", "level-editor"]
        },
        {
            "name": "ci-macos",
            "configurePreset": "ci-macos",
            "targets": ["pixel-roguelike", "level-editor"]
        }
    ]
}
