# =====================================================
# ENVIRONMENTAL DETAILS
# =====================================================

# HVAC vent above Door B (north wall, center)
mesh inst_hvac_vent 0.0 3.2 5.95 1.0 1.0 1.0 0.0 180.0 0.0 material metal_default tint 0.55 0.53 0.50 node n_hvac

# Smoke detector on ceiling (slightly off-center)
mesh inst_smoke_detector 1.0 3.97 1.5 1.0 1.0 1.0 0.0 0.0 0.0 material stone_default tint 0.92 0.90 0.88 node n_smoke

# Ceiling light panels (four rectangular fluorescent fixtures for larger space)
mesh ceiling_light_panel -2.5 3.99  0.5 1.0 1.0 1.0 0.0 0.0 0.0 material stone_default tint 0.98 0.96 0.90 node n_clp1
mesh ceiling_light_panel  2.5 3.99  0.5 1.0 1.0 1.0 0.0 0.0 0.0 material stone_default tint 0.98 0.96 0.90 node n_clp2
