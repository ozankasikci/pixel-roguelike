# =====================================================
# Level 1 — Starting Room (Room 427)
# Reference: docs/concept-art/level-01-first-room/
# Layout: 6m wide (X) x 4m deep (Z) x 4m tall (Y)
# Bounds: X[-3, 3]  Y[0, 4]  Z[0, 4]
# =====================================================
environment_profile default

# --- Floor (3x2 grid of prison_floor tiles) ---
mesh prison_floor -2.0 0.0 1.0 1.0 1.0 1.0 0.0 0.0 0.0 material inst_glossy_floor tint 1.0 1.0 1.0 node n_f1
mesh prison_floor  0.0 0.0 1.0 1.0 1.0 1.0 0.0 0.0 0.0 material inst_glossy_floor tint 1.01 1.01 1.0 node n_f2
mesh prison_floor  2.0 0.0 1.0 1.0 1.0 1.0 0.0 0.0 0.0 material inst_glossy_floor tint 1.0 1.0 1.0 node n_f3
mesh prison_floor -2.0 0.0 3.0 1.0 1.0 1.0 0.0 0.0 0.0 material inst_glossy_floor tint 1.01 1.0 1.0 node n_f4
mesh prison_floor  0.0 0.0 3.0 1.0 1.0 1.0 0.0 0.0 0.0 material inst_glossy_floor tint 1.0 1.0 1.0 node n_f5
mesh prison_floor  2.0 0.0 3.0 1.0 1.0 1.0 0.0 0.0 0.0 material inst_glossy_floor tint 1.01 1.01 1.0 node n_f6

# --- Ceiling (3x2 grid) ---
mesh prison_ceiling -2.0 4.0 1.0 1.0 1.0 1.0 0.0 0.0 0.0 material ceiling_default tint 0.94 0.92 0.88 node n_c1
mesh prison_ceiling  0.0 4.0 1.0 1.0 1.0 1.0 0.0 0.0 0.0 material ceiling_default tint 0.93 0.91 0.87 node n_c2
mesh prison_ceiling  2.0 4.0 1.0 1.0 1.0 1.0 0.0 0.0 0.0 material ceiling_default tint 0.94 0.92 0.88 node n_c3
mesh prison_ceiling -2.0 4.0 3.0 1.0 1.0 1.0 0.0 0.0 0.0 material ceiling_default tint 0.93 0.91 0.87 node n_c4
mesh prison_ceiling  0.0 4.0 3.0 1.0 1.0 1.0 0.0 0.0 0.0 material ceiling_default tint 0.94 0.92 0.88 node n_c5
mesh prison_ceiling  2.0 4.0 3.0 1.0 1.0 1.0 0.0 0.0 0.0 material ceiling_default tint 0.93 0.91 0.87 node n_c6

# --- South wall (Z=0) — Entry wall, behind player ---
mesh prison_wall -2.0 0.0 0.0 1.0 1.0 1.0 0.0 0.0 0.0 material inst_beige_wall tint 1.0 1.0 1.0 node n_ws1
mesh prison_wall  0.0 0.0 0.0 1.0 1.0 1.0 0.0 0.0 0.0 material inst_beige_wall tint 1.0 1.0 1.0 node n_ws2
mesh prison_wall  2.0 0.0 0.0 1.0 1.0 1.0 0.0 0.0 0.0 material inst_beige_wall tint 1.0 1.0 1.0 node n_ws3

# --- North wall (Z=4) — Door B (metal, center) ---
mesh prison_wall      -2.0 0.0 4.0 1.0 1.0 1.0 0.0 180.0 0.0 material inst_beige_wall tint 1.0 1.0 1.0 node n_wn1
mesh prison_wall_door  0.0 0.0 4.0 1.0 1.0 1.0 0.0 180.0 0.0 material inst_beige_wall tint 1.0 1.0 1.0 node n_wn2
mesh prison_wall       2.0 0.0 4.0 1.0 1.0 1.0 0.0 180.0 0.0 material inst_beige_wall tint 1.0 1.0 1.0 node n_wn3

# --- West wall (X=-3) — Door A (wooden, open) ---
mesh prison_wall      -3.0 0.0 1.0 1.0 1.0 1.0 0.0 90.0 0.0 material inst_beige_wall tint 1.0 1.0 1.0 node n_ww1
mesh prison_wall_door -3.0 0.0 3.0 1.0 1.0 1.0 0.0 90.0 0.0 material inst_beige_wall tint 1.0 1.0 1.0 node n_ww2

# --- East wall (X=3) — Door C (white, padlocked) ---
mesh prison_wall       3.0 0.0 1.0 1.0 1.0 1.0 0.0 -90.0 0.0 material inst_beige_wall tint 1.0 1.0 1.0 node n_we1
mesh prison_wall_door  3.0 0.0 3.0 1.0 1.0 1.0 0.0 -90.0 0.0 material inst_beige_wall tint 1.0 1.0 1.0 node n_we2

# --- Baseboards (dark trim at floor level) ---
# South wall
mesh prison_baseboard -2.0 0.0 0.1 1.0 1.0 1.0 0.0 0.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_bb_s1
mesh prison_baseboard  0.0 0.0 0.1 1.0 1.0 1.0 0.0 0.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_bb_s2
mesh prison_baseboard  2.0 0.0 0.1 1.0 1.0 1.0 0.0 0.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_bb_s3
# North wall
mesh prison_baseboard -2.0 0.0 3.9 1.0 1.0 1.0 0.0 180.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_bb_n1
mesh prison_baseboard  0.0 0.0 3.9 1.0 1.0 1.0 0.0 180.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_bb_n2
mesh prison_baseboard  2.0 0.0 3.9 1.0 1.0 1.0 0.0 180.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_bb_n3
# East wall
mesh prison_baseboard  2.9 0.0 1.0 1.0 1.0 1.0 0.0 -90.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_bb_e1
mesh prison_baseboard  2.9 0.0 3.0 1.0 1.0 1.0 0.0 -90.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_bb_e2
# West wall
mesh prison_baseboard -2.9 0.0 1.0 1.0 1.0 1.0 0.0 90.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_bb_w1
mesh prison_baseboard -2.9 0.0 3.0 1.0 1.0 1.0 0.0 90.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_bb_w2

# --- Crown molding (dark trim at ceiling, flipped) ---
# South wall
mesh prison_baseboard -2.0 3.95 0.1 1.0 1.0 1.0 180.0 0.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_cm_s1
mesh prison_baseboard  0.0 3.95 0.1 1.0 1.0 1.0 180.0 0.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_cm_s2
mesh prison_baseboard  2.0 3.95 0.1 1.0 1.0 1.0 180.0 0.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_cm_s3
# North wall
mesh prison_baseboard -2.0 3.95 3.9 1.0 1.0 1.0 180.0 180.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_cm_n1
mesh prison_baseboard  0.0 3.95 3.9 1.0 1.0 1.0 180.0 180.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_cm_n2
mesh prison_baseboard  2.0 3.95 3.9 1.0 1.0 1.0 180.0 180.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_cm_n3
# East wall
mesh prison_baseboard  2.9 3.95 1.0 1.0 1.0 1.0 180.0 -90.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_cm_e1
mesh prison_baseboard  2.9 3.95 3.0 1.0 1.0 1.0 180.0 -90.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_cm_e2
# West wall
mesh prison_baseboard -2.9 3.95 1.0 1.0 1.0 1.0 180.0 90.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_cm_w1
mesh prison_baseboard -2.9 3.95 3.0 1.0 1.0 1.0 180.0 90.0 0.0 material inst_dark_trim tint 1.0 1.0 1.0 node n_cm_w2

# =====================================================
# DOORS (QuestDoorsPack assets)
# QuestDoorsPack models are authored at ~9.2m height (FBX cm, AI_CONFIG_FBX_CONVERT_TO_M=true
# with aiProcess_PreTransformVertices bakes root transform into vertices).
# Scale factor 0.21 fits the 2.1m prison_wall_door opening (2.0m leaf target, computed
# from AABB measurement via tests/engine/test_questdoor_scale — see 260402-1l5 task).
# All three door models share the same pack scale: ~9.16-9.22m tall x ~4.05-4.07m wide.
# =====================================================

# --- Door A: Staff Break Room (wooden, OPEN) — West wall ---
# Door leaf swung open (~80deg into break room)
mesh SM_DoorA -3.05 0.0 3.0 0.21 0.21 0.21 0.0 170.0 0.0 material qdp_door_a tint 1.0 1.0 1.0 node n_door_a

# --- Door B: Maintenance Corridor (gray metal, CLOSED) — North wall ---
mesh SM_DoorD 0.0 0.0 3.95 0.21 0.21 0.21 0.0 180.0 0.0 material qdp_door_d tint 0.60 0.58 0.55 node n_door_b

# --- Door C: Observation Room (white, CLOSED + padlocked) — East wall ---
mesh SM_DoorC 2.95 0.0 3.0 0.21 0.21 0.21 0.0 -90.0 0.0 material qdp_door_c tint 0.88 0.85 0.80 node n_door_c
# Chain and padlock on Door C
mesh inst_chain_padlock 2.90 1.1 3.0 1.0 1.0 1.0 0.0 -90.0 0.0 material metal_default tint 0.20 0.16 0.12 node n_chain

# =====================================================
# ENVIRONMENTAL DETAILS
# =====================================================

# HVAC vent above Door B
mesh inst_hvac_vent 0.0 3.2 3.95 1.0 1.0 1.0 0.0 180.0 0.0 material metal_default tint 0.55 0.53 0.50 node n_hvac

# Smoke detector on ceiling (slightly off-center)
mesh inst_smoke_detector 0.5 3.97 2.0 1.0 1.0 1.0 0.0 0.0 0.0 material stone_default tint 0.92 0.90 0.88 node n_smoke

# Ceiling light panels (two rectangular fluorescent fixtures)
mesh ceiling_light_panel -0.5 3.99 1.5 1.0 1.0 1.0 0.0 0.0 0.0 material stone_default tint 0.98 0.96 0.90 node n_clp1
mesh ceiling_light_panel  1.0 3.99 2.8 1.0 1.0 1.0 0.0 0.0 0.0 material stone_default tint 0.98 0.96 0.90 node n_clp2

# =====================================================
# LIGHTING
# =====================================================

# Warm white fluorescent ceiling lights
light -0.5 3.7 1.5 1.0 0.97 0.88 6.0 4.5 node n_l1
light  1.0 3.7 2.8 1.0 0.97 0.88 6.0 4.5 node n_l2

# Warm golden light spilling through open Door A (break room beyond)
light -3.5 1.5 3.0 1.0 0.90 0.65 8.0 5.0 node n_l_door_a
# Secondary fill from Door A at floor level
light -2.8 0.3 3.0 1.0 0.85 0.55 3.0 1.5 node n_l_door_a_floor

# Subtle ambient fill
light 0.0 2.5 0.5 0.85 0.80 0.72 4.0 1.0 node n_l_fill

# Red LED on smoke detector
light 0.5 3.85 2.0 1.0 0.05 0.02 0.5 0.3 node n_l_led

# =====================================================
# COLLIDERS
# =====================================================

# Floor
collider_box  0.0 -0.05 2.0 3.0 0.05 2.0 node n_col_floor
# Ceiling
collider_box  0.0  4.05 2.0 3.0 0.05 2.0 node n_col_ceil
# South wall (entry)
collider_box  0.0  2.0  0.0 3.0 2.0 0.1 node n_col_south
# North wall (Door B — collider has gap for door later)
collider_box  0.0  2.0  4.0 3.0 2.0 0.1 node n_col_north
# East wall (Door C — locked, full collider)
collider_box  3.0  2.0  2.0 0.1 2.0 2.0 node n_col_east
# West wall (Door A — open, collider has gap for passage later)
collider_box -3.0  2.0  2.0 0.1 2.0 2.0 node n_col_west

# =====================================================
# PLAYER SPAWN
# =====================================================

# Near south wall, facing north (+Z toward the three doors)
player_spawn 0.0 1.0 1.0 -2.0 node n_spawn
