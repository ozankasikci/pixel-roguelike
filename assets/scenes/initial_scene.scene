# =====================================================
# LIGHTING
# =====================================================

# Warm white fluorescent ceiling lights — 4 fixtures for larger space
light -2.5 3.7  0.5 1.0 0.97 0.88 6.0 4.5 node n_l1
light  2.5 3.7  0.5 1.0 0.97 0.88 6.0 4.5 node n_l2
light -2.5 3.7  3.5 1.0 0.97 0.88 6.0 4.5 node n_l3
light  2.5 3.7  3.5 1.0 0.97 0.88 6.0 4.5 node n_l4

# Warm golden light spilling through open Door A (west wall, break room beyond)
light -5.5 1.5 1.0 1.0 0.90 0.65 8.0 5.0 node n_l_door_a
# Secondary fill from Door A at floor level
light -4.8 0.3 1.0 1.0 0.85 0.55 3.0 1.5 node n_l_door_a_floor

# Subtle ambient fill (back of room)
light  0.0 2.5 -1.5 0.85 0.80 0.72 5.0 1.0 node n_l_fill

# Red LED on smoke detector
light  1.0 3.85 1.5 1.0 0.05 0.02 0.5 0.3 node n_l_led

# =====================================================
# COLLIDERS
# =====================================================

# Floor
collider_box  0.0 -0.05  2.0 5.0 0.05 4.0 node n_col_floor
# Ceiling
collider_box  0.0  4.05  2.0 5.0 0.05 4.0 node n_col_ceil
# South wall (entry)
collider_box  0.0  2.0  -2.0 5.0 2.0 0.1 node n_col_south
# North wall (Door B — full collider, door collider handles blocking)
collider_box  0.0  2.0   6.0 5.0 2.0 0.1 node n_col_north
# East wall (Door C — locked, full collider)
collider_box  5.0  2.0   2.0 0.1 2.0 4.0 node n_col_east
# West wall (Door A — full collider, door handles passage)
collider_box -5.0  2.0   2.0 0.1 2.0 4.0 node n_col_west

# =====================================================
# PLAYER SPAWN
# =====================================================

# Near south wall, facing north (+Z toward the three doors)
player_spawn 0.0 1.0 -0.5 -2.0 node n_spawn
